          "name": "10 - Exportar PDF Credencial por Hash",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "url": {
              "raw": "{{base_url}}/apig/tardigitales/admin/tarjetas/verificar/{{hash_tarjeta}}/pdf?client_id={{client_id}}&download=true",
              "host": ["{{base_url}}"],
              "path": ["apig", "tardigitales", "admin", "tarjetas", "verificar", "{{hash_tarjeta}}", "pdf"],
              "query": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "download",
                  "value": "true"
                }
              ]
            },
            "description": "Genera y descarga el archivo PDF oficial de la tarjeta digital con su código QR para compartir."
          },
          "response": []
        }
      ]
    }
