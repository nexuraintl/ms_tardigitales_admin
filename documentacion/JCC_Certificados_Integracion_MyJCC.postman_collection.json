					],
					"path": [
						"apig",
						"tardigitales",
						"admin",
						"certificados",
						"procesar"
					]
				},
				"description": "Primera emisión de certificado para sociedad de contadores (Nuevo: true). Retorna 200 OK con el stream binario del PDF firmado digitalmente."
			},
			"response": []
		},
		{
