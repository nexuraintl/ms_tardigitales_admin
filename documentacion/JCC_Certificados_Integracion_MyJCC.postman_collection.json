{
	"info": {
		"_postman_id": "f29d8174-8142-498c-9c7b-certificados-doc",
		"name": "JCC Certificados - Integración MyJCC (Documentación Oficial)",
		"description": "Colección oficial de referencia técnica para terceros (MyJCC) para el consumo del servicio de autenticación y procesamiento de certificados en Preproducción.\n\nContenido:\n1. POST /apig/core/auth/token - Obtención del Bearer Token\n2. POST /apig/tardigitales/admin/certificados/procesar - Emisión Contador (Nuevo: true)\n3. POST /apig/tardigitales/admin/certificados/procesar - Emisión Sociedad (Nuevo: true)\n4. POST /apig/tardigitales/admin/certificados/procesar - Redescarga (Nuevo: false)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://preproduccion9-jcc.nexura.com.co",
			"type": "string"
		},
		{
			"key": "client_id",
			"value": "20060",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01 - Obtener Token de Acceso (Core Auth)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.access_token) {",
							"    pm.collectionVariables.set('access_token', jsonData.access_token);",
							"    console.log('✅ Access Token obtenido y asignado a {{access_token}}');",
							"} else {",
							"    console.error('❌ No se encontró access_token en la respuesta:', jsonData);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"user\": \"tu_usuario\",\n  \"password\": \"tu_password\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/apig/core/auth/token",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"apig",
						"core",
						"auth",
						"token"
					]
				},
				"description": "Endpoint de autenticación para obtener el token JWT. Reemplazar tu_client_id, tu_usuario y tu_password con las credenciales suministradas."
			},
			"response": []
		},
		{
			"name": "02 - Procesar Certificado Contador (Primera Emisión)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/pdf"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"Nuevo\": true,\n  \"fechaGeneracion\": \"2026-10-12\",\n  \"tipo\": \"contador\",\n  \"documento\": \"1000000000\",\n  \"N_CERTIFICADO\": \"0221114451sa\",\n  \"historia\": \"5\",\n  \"dirigido\": \"QUIEN INTERESE\",\n  \"Detalles\": {\n    \"CON_CODIGO\": 100001,\n    \"CON_NOMBRES\": \"CARLOS ANDRES\",\n    \"CON_APELLIDO1\": \"PEREZ\",\n    \"CON_APELLIDO2\": \"GOMEZ\",\n    \"TDOC_CODIGO\": \"CC\",\n    \"CON_NRO_DOCUMENTO\": 1000000000,\n    \"MUNICIPIO_DOCUMENTO\": \"BOGOTA D.C.\",\n    \"DEPARTAMENTO_DOCUMENTO\": \"BOGOTA D.C.\",\n    \"CON_NRO_TARJETA\": 123456,\n    \"CON_TIPO_TARJETA\": \"T\",\n    \"CON_SEXO\": \"M\",\n    \"ESTADO\": \"ACTIVO\",\n    \"CON_FECHA_ACTUALIZACION\": \"2026-10-15 08:30:00\",\n    \"EMAIL\": \"carlos.perez@ejemplo.com\",\n    \"ANTECEDENTES\": [\n      {\n        \"SAN_TIPO\": \"S\",\n        \"SAN_MESES\": 12,\n        \"SAN_RESOLUCION\": \"T-000-0001\",\n        \"SAN_FECHA_RESOLUCION\": \"2025-01-15 00:00:00\",\n        \"SAN_FECHA_EJECUTORIA\": \"2025-02-04 00:00:00\",\n        \"SAN_FECHA_FIN\": \"2026-02-04 00:00:00\"\n      }\n    ]\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/apig/tardigitales/admin/certificados/procesar",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"apig",
						"tardigitales",
						"admin",
						"certificados",
						"procesar"
					]
				},
				"description": "Primera emisión de certificado para contador público (Nuevo: true). Retorna 200 OK con el stream binario del PDF firmado digitalmente."
			},
			"response": []
		},
		{
